# Copy to .env and fill locally. Never commit real credentials.
# Preferred: comma-separated tokens for low-frequency research validation.
# Every token owner must explicitly authorize that use.
TUSHARE_TOKENS=
# Backward-compatible single token.
TUSHARE_TOKEN=
# 2000-point account used by Tushare2kAdapter (index membership, adj_factor, stk_limit, suspend_d).
TUSHARE_2K_TOKEN=
