{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agent-maintenance/session-start.sh\" codex",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
