{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/manifests/canonical-v1.json",
  "title": "Canonical partition manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version", "dataset", "schema_version", "partition_date",
    "row_count", "columns", "dtypes", "data_checksum_sha256",
    "schema_checksum_sha256", "code_fingerprint", "run_id", "created_at",
    "generation_id", "trust_anchor_sha256"
  ],
  "properties": {
    "manifest_version": {"const": 1},
    "dataset": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "minLength": 1},
    "partition_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "row_count": {"type": "integer", "minimum": 0},
    "columns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "minItems": 1},
    "dtypes": {"type": "object", "additionalProperties": {"type": "string"}},
    "data_checksum_sha256": {"$ref": "#/$defs/sha256"},
    "schema_checksum_sha256": {"$ref": "#/$defs/sha256"},
    "code_fingerprint": {"$ref": "#/$defs/sha256"},
    "run_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "lineage": {"type": "object"},
    "source_versions": {"type": "object"},
    "quality_report_checksum": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"const": ""}]},
    "raw_artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["artifact_ref", "checksum_sha256"],
        "properties": {
          "artifact_ref": {"type": "string"},
          "checksum_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "generation_id": {"$ref": "#/$defs/sha256"},
    "trust_anchor_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
