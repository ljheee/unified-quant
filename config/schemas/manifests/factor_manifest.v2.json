{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/factor_manifest.v2.json",
  "title": "Factor partition manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "input_dataset",
    "input_schema_version",
    "factor_set",
    "factor_version",
    "partition_date",
    "decision_time",
    "run_visible_cutoff",
    "inputs",
    "factor_definitions",
    "universe_snapshot",
    "row_count",
    "columns",
    "dtypes",
    "data_checksum_sha256",
    "logical_fingerprint",
    "engine_version",
    "code_fingerprint",
    "engine_contract",
    "serialization_profile_id",
    "engine_package_provenance",
    "run_id",
    "created_at",
    "quality",
    "manifest_digest_sha256",
    "generation_id"
  ],
  "properties": {
    "manifest_version": {
      "const": 2
    },
    "input_dataset": {
      "type": "string"
    },
    "input_schema_version": {
      "type": "string"
    },
    "factor_set": {
      "type": "string"
    },
    "factor_version": {
      "$ref": "#/$defs/semver"
    },
    "partition_date": {
      "$ref": "#/$defs/date"
    },
    "decision_time": {
      "$ref": "#/$defs/date_time"
    },
    "run_visible_cutoff": {
      "$ref": "#/$defs/date_time"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding",
          "dataset",
          "schema_version",
          "partition_date",
          "manifest_generation_id",
          "data_checksum_sha256",
          "upstream_created_at"
        ],
        "properties": {
          "binding": {
            "enum": [
              "bars",
              "adjustment",
              "universe"
            ]
          },
          "dataset": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "partition_date": {
            "$ref": "#/$defs/date"
          },
          "manifest_generation_id": {
            "$ref": "#/$defs/sha256"
          },
          "data_checksum_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "upstream_created_at": {
            "$ref": "#/$defs/date_time"
          },
          "schema_checksum_sha256": {
            "oneOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "adjustment_snapshot_id": {
            "oneOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "effective_date_table_checksum": {
            "oneOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "factor_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "implementation_fingerprint",
          "qlib_name",
          "expression"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "$ref": "#/$defs/semver"
          },
          "implementation_fingerprint": {
            "$ref": "#/$defs/sha256"
          },
          "minimum_history": {
            "type": "integer",
            "minimum": 0
          },
          "qlib_name": {
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "universe_snapshot": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_generation_id",
            "checksum_sha256"
          ],
          "properties": {
            "artifact_generation_id": {
              "$ref": "#/$defs/sha256"
            },
            "checksum_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 2
    },
    "dtypes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "data_checksum_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "logical_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "engine_version": {
      "type": "string"
    },
    "engine_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_name",
        "engine_version",
        "qlib_expression_set"
      ],
      "properties": {
        "engine_name": {
          "const": "qlib"
        },
        "engine_version": {
          "type": "string",
          "minLength": 1
        },
        "qlib_expression_set": {
          "enum": [
            "Alpha158",
            "Alpha360"
          ]
        }
      }
    },
    "code_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "serialization_profile_id": {
      "type": "string"
    },
    "engine_package_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_version",
        "python_version",
        "dependency_lock_digest_sha256"
      ],
      "properties": {
        "project_version": {
          "type": "string"
        },
        "python_version": {
          "type": "string"
        },
        "dependency_lock_digest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "created_at": {
      "$ref": "#/$defs/date_time"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "policy",
        "report_checksum_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "warning",
            "rejected"
          ]
        },
        "policy": {
          "enum": [
            "reject_all",
            "accept_with_warnings"
          ]
        },
        "report_checksum_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "manifest_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "generation_id": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}
