{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/risk_decision.v1.json",
  "title": "risk_decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "schema_version",
    "decision_scope",
    "risk_policy_binding",
    "risk_state_binding",
    "input_bindings",
    "as_of_date",
    "visible_through",
    "findings",
    "action",
    "constraints",
    "decision_digest",
    "files",
    "producer",
    "serialization_profile",
    "generation_id",
    "manifest_digest_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "decision_scope": {
      "enum": [
        "portfolio_publication",
        "order_submission"
      ]
    },
    "risk_policy_binding": {
      "$ref": "#/$defs/binding"
    },
    "risk_state_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "as_of_date": {
      "$ref": "#/$defs/date"
    },
    "visible_through": {
      "$ref": "#/$defs/date_time"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "result",
          "severity",
          "action",
          "state_required"
        ],
        "properties": {
          "rule_id": {
            "$ref": "#/$defs/path_segment"
          },
          "observed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "operator": {
            "anyOf": [
              {
                "enum": [
                  "greater_than",
                  "greater_than_or_equal",
                  "less_than",
                  "less_than_or_equal"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "severity": {
            "enum": [
              "warning",
              "error",
              "critical"
            ]
          },
          "action": {
            "enum": [
              "allow",
              "warn",
              "resize",
              "block",
              "block_order",
              "block_new_buy",
              "de_risk",
              "flatten",
              "halt_strategy",
              "escalate_review"
            ]
          },
          "state_required": {
            "type": "boolean"
          }
        }
      }
    },
    "action": {
      "enum": [
        "allow",
        "warn",
        "resize",
        "block",
        "block_order",
        "block_new_buy",
        "de_risk",
        "flatten",
        "halt_strategy",
        "escalate_review"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "constraint_type",
          "value"
        ],
        "properties": {
          "constraint_type": {
            "enum": [
              "allowed_weight",
              "allowed_fraction",
              "allowed_shares",
              "allowed_notional"
            ]
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "instrument": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]{1,64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "decision_digest": {
      "$ref": "#/$defs/sha256"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "serialization_profile": {
      "const": "json-canonical-v1"
    },
    "generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "binding_config_generation_id": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "path_segment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "generation_id",
        "manifest_digest_sha256"
      ],
      "properties": {
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "generation_id": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_digest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_size",
        "serialization_profile"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "serialization_profile": {
          "enum": [
            "json-canonical-v1",
            "parquet-v1",
            "ndjson-v1"
          ]
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_code_fingerprint",
        "run_id",
        "created_at"
      ],
      "properties": {
        "producer_code_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "$ref": "#/$defs/uuid"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "created_at": {
          "$ref": "#/$defs/date_time"
        }
      }
    }
  }
}
