{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/factor_exposure_panel.v1.json",
  "title": "Point-in-time factor exposure panel v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "source_id", "source_approval_ref", "controls",
    "decision_time_policy", "coverage_start_date", "coverage_end_date",
    "columns", "row_count", "data_checksum_sha256", "logical_fingerprint",
    "serialization_profile_id", "quality_report_checksum_sha256", "run_id",
    "created_at", "generation_id", "manifest_digest_sha256"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_approval_ref": {"type": "string", "minLength": 1},
    "controls": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["industry", "market_cap", "liquidity"]}
    },
    "decision_time_policy": {"const": "session_close_asia_shanghai_v1"},
    "coverage_start_date": {"$ref": "#/$defs/session"},
    "coverage_end_date": {"$ref": "#/$defs/session"},
    "columns": {
      "type": "array", "minItems": 4, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "row_count": {"type": "integer", "minimum": 1},
    "data_checksum_sha256": {"$ref": "#/$defs/sha256"},
    "logical_fingerprint": {"$ref": "#/$defs/sha256"},
    "serialization_profile_id": {"const": "parquet-snappy-v1"},
    "quality_report_checksum_sha256": {"$ref": "#/$defs/sha256"},
    "run_id": {"$ref": "#/$defs/uuid"},
    "created_at": {"$ref": "#/$defs/date_time"},
    "generation_id": {"$ref": "#/$defs/sha256"},
    "manifest_digest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "format": "uuid"},
    "date_time": {"type": "string", "format": "date-time"},
    "session": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
