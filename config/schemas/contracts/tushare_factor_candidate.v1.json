{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/tushare_factor_candidate.v1.json",
  "title": "Tushare derived factor candidate bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "kind", "availability_policy", "strict_pit_eligible",
    "historical_vintage_verified", "builder_code_sha256", "dependency_lock_sha256",
    "factor_definitions", "exposure_definitions", "calendar_sessions", "source_snapshots",
    "factor_columns", "exposure_controls", "factor_artifact", "exposure_artifact",
    "generation_id"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "kind": {"const": "tushare_factor_candidate_bundle"},
    "availability_policy": {"const": "prior_session_data_visible_by_decision_session_close_assumption_v1"},
    "strict_pit_eligible": {"const": false},
    "historical_vintage_verified": {"const": false},
    "builder_code_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
    "factor_definitions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "version", "sources", "formula"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
          "sources": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["dataset", "fields"],
              "properties": {
                "dataset": {"enum": ["daily_basic", "moneyflow"]},
                "fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "formula": {"type": "string", "minLength": 1}
        }
      }
    },
    "exposure_definitions": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["control", "source_dataset", "source_field", "units"],
        "properties": {
          "control": {"enum": ["market_cap", "liquidity"]},
          "source_dataset": {"const": "daily_basic"},
          "source_field": {"type": "string", "minLength": 1},
          "units": {"type": "string", "minLength": 1}
        }
      }
    },
    "calendar_sessions": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["session_date", "manifest_generation_id", "data_checksum_sha256"],
        "properties": {
          "session_date": {"$ref": "#/$defs/date"},
          "manifest_generation_id": {"$ref": "#/$defs/sha256"},
          "data_checksum_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "source_snapshots": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dataset", "trade_date", "generation_id", "data_checksum_sha256", "source_fetched_at", "row_count"],
        "properties": {
          "dataset": {"enum": ["daily_basic", "moneyflow"]},
          "trade_date": {"$ref": "#/$defs/date"},
          "generation_id": {"$ref": "#/$defs/sha256"},
          "data_checksum_sha256": {"$ref": "#/$defs/sha256"},
          "source_fetched_at": {"type": "string", "format": "date-time"},
          "row_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "factor_columns": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "exposure_controls": {
      "const": ["market_cap", "liquidity"]
    },
    "factor_artifact": {"$ref": "#/$defs/artifact"},
    "exposure_artifact": {"$ref": "#/$defs/artifact"},
    "generation_id": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "format": "date"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["filename", "checksum_sha256", "row_count", "columns"],
      "properties": {
        "filename": {"type": "string", "enum": ["factors.parquet", "exposures.parquet"]},
        "checksum_sha256": {"$ref": "#/$defs/sha256"},
        "row_count": {"type": "integer", "minimum": 1},
        "columns": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
