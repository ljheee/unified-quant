{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/prediction_set.v1.json",
  "title": "Immutable prediction set manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "prediction_set_name",
    "model_artifact_generation_id",
    "model_artifact_checksum_sha256",
    "input_dataset_generation_id",
    "decision_date",
    "visible_cutoff",
    "score_semantics",
    "declared_output_columns",
    "actual_output_columns",
    "column_set_exact_match",
    "eligibility_policy",
    "row_count",
    "data_checksum_sha256",
    "serialization_profile_id",
    "run_id",
    "created_at",
    "manifest_digest_sha256",
    "generation_id"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "prediction_set_name": {
      "$ref": "#/$defs/path_segment"
    },
    "model_artifact_generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "model_artifact_checksum_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_dataset_generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "decision_date": {
      "$ref": "#/$defs/date"
    },
    "visible_cutoff": {
      "$ref": "#/$defs/date_time"
    },
    "score_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "unit",
        "direction",
        "ranking_scope",
        "tie_policy",
        "normalization"
      ],
      "properties": {
        "column": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "higher_better",
            "lower_better"
          ]
        },
        "ranking_scope": {
          "type": "string"
        },
        "tie_policy": {
          "type": "string"
        },
        "normalization": {
          "type": "string"
        }
      }
    },
    "probability_column": {
      "type": "string"
    },
    "rank_column": {
      "type": "string"
    },
    "declared_output_columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "actual_output_columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "column_set_exact_match": {
      "const": true
    },
    "eligibility_policy": {
      "type": "string",
      "minLength": 1
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "data_checksum_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "serialization_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "created_at": {
      "$ref": "#/$defs/date_time"
    },
    "manifest_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "generation_id": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "path_segment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {"enum": [".", ".."]}
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    }
  }
}
