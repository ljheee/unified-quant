{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backtest market dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_version",
    "dataset_type",
    "generation_id",
    "manifest_digest_sha256",
    "window_start",
    "window_end",
    "columns",
    "row_count",
    "data_checksum_sha256",
    "sources",
    "producer",
    "serialization_profile"
  ],
  "properties": {
    "dataset_version": {
      "const": "1.0.0"
    },
    "dataset_type": {
      "enum": [
        "calendar",
        "suspension",
        "corporate_action",
        "corporate_action_events"
      ]
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "window_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    },
    "row_count": {
      "type": "integer",
      "minimum": 1
    },
    "data_checksum_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "serialization_profile": {
      "const": "parquet-v1"
    }
  }
}
