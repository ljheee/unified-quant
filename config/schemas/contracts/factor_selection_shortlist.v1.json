{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/factor_selection_shortlist.v1.json",
  "title": "Validation-only factor selection shortlist v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version", "kind", "publication_scope", "screen_report_generation_id",
    "validation_window", "policy", "selected_candidates", "decisions", "limitations", "generation_id"
  ],
  "properties": {
    "record_version": {"const": 1},
    "kind": {"const": "factor_selection_shortlist"},
    "publication_scope": {"const": "validation_only_shortlist_no_factor_promotion"},
    "screen_report_generation_id": {"$ref": "#/$defs/sha256"},
    "validation_window": {
      "type": "object", "additionalProperties": false,
      "required": ["start_date", "end_date", "session_count"],
      "properties": {
        "start_date": {"$ref": "#/$defs/date"},
        "end_date": {"$ref": "#/$defs/date"},
        "session_count": {"type": "integer", "minimum": 1}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "protocol_version", "score_directions", "minimum_valid_rank_ic_sessions",
        "minimum_rank_ic_t_statistic", "minimum_positive_rank_ic_fraction",
        "minimum_coverage_fraction", "minimum_pairwise_sessions",
        "maximum_absolute_daily_spearman", "maximum_mean_turnover_cost_bps",
        "maximum_selected_features"
      ],
      "properties": {
        "protocol_version": {"const": 1},
        "score_directions": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": [-1, 1]}},
        "minimum_valid_rank_ic_sessions": {"type": "integer", "minimum": 1},
        "minimum_rank_ic_t_statistic": {"type": "number"},
        "minimum_positive_rank_ic_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_coverage_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_pairwise_sessions": {"type": "integer", "minimum": 1},
        "maximum_absolute_daily_spearman": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "maximum_mean_turnover_cost_bps": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "maximum_selected_features": {"type": "integer", "minimum": 1}
      }
    },
    "selected_candidates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "decisions": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "feature", "score_direction", "adjusted_mean_rank_ic",
          "adjusted_rank_ic_t_statistic", "adjusted_positive_rank_ic_fraction",
          "feature_coverage_fraction", "mean_turnover_cost_proxy_bps_of_nav",
          "status", "reasons"
        ],
        "properties": {
          "feature": {"type": "string", "minLength": 1},
          "score_direction": {"enum": [-1, 1]},
          "adjusted_mean_rank_ic": {"oneOf": [{"type": "number"}, {"type": "null"}]},
          "adjusted_rank_ic_t_statistic": {"oneOf": [{"type": "number"}, {"type": "null"}]},
          "adjusted_positive_rank_ic_fraction": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]},
          "feature_coverage_fraction": {"type": "number", "minimum": 0},
          "mean_turnover_cost_proxy_bps_of_nav": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
          "status": {"enum": ["eligible", "rejected", "deprioritized"]},
          "reasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "generation_id": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "format": "date"}
  }
}
