{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/model_definition.v1.json",
  "title": "Reviewed model definition manifest v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version","model_set","model_version","status","algorithm","hyperparameters","seed_policy","feature_schema_generation_id","compatible_dataset_versions","metrics","selection_rule","quality_policy","serializer_version","code_fingerprint","model_run_content_generation_id","run_id","created_at","manifest_digest_sha256","generation_id"],
  "properties": {
    "contract_version": {"const": 1}, "model_set": {"$ref":"#/$defs/path_segment"}, "model_version": {"$ref":"#/$defs/semver"}, "status": {"const":"reviewed"}, "algorithm": {"enum":["regularized_linear","qlib_linear"]}, "hyperparameters": {"type":"object"},
    "seed_policy": {"type":"object","additionalProperties":false,"required":["base_seed","derivation"],"properties":{"base_seed":{"type":"integer"},"derivation":{"type":"string"}}},
    "feature_schema_generation_id": {"$ref":"#/$defs/sha256"}, "compatible_dataset_versions": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/semver"}},
    "metrics": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","direction"],"properties":{"name":{"type":"string"},"direction":{"enum":["maximize","minimize"]}}}},
    "selection_rule": {"type":"string","minLength":1}, "quality_policy": {"enum":["reject_all","accept_with_warnings"]}, "serializer_version": {"enum":["json-numpy-v1","joblib-v1"]}, "code_fingerprint": {"$ref":"#/$defs/sha256"}, "model_run_content_generation_id": {"$ref":"#/$defs/sha256"}, "run_id": {"$ref":"#/$defs/uuid"}, "created_at": {"$ref":"#/$defs/date_time"}, "manifest_digest_sha256": {"$ref":"#/$defs/sha256"}, "generation_id": {"$ref":"#/$defs/sha256"}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"uuid":{"type":"string","format":"uuid"},"semver":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},"date_time":{"type":"string","format":"date-time"},"path_segment":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$","not":{"enum":[".",".."]}}}
}
