{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/tushare_factor_candidate_screen_report.v1.json",
  "title": "Diagnostic screen of Tushare derived factor candidates v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version", "kind", "publication_scope", "strict_pit_eligible",
    "historical_vintage_verified", "window", "input_bindings", "environment_binding", "protocol",
    "feature_summary", "pairwise_collinearity", "daily", "generation_id"
  ],
  "properties": {
    "record_version": {"const": 1},
    "kind": {"const": "tushare_factor_candidate_screen_report"},
    "publication_scope": {"const": "diagnostic_only_no_factor_selection"},
    "strict_pit_eligible": {"const": false},
    "historical_vintage_verified": {"const": false},
    "window": {
      "type": "object", "additionalProperties": false,
      "required": ["start_date", "end_date", "session_count"],
      "properties": {
        "start_date": {"$ref": "#/$defs/date"},
        "end_date": {"$ref": "#/$defs/date"},
        "session_count": {"type": "integer", "minimum": 1}
      }
    },
    "input_bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_bundle", "label", "calendar", "backtest_cost_config"],
      "properties": {
        "candidate_bundle": {
          "type": "object", "additionalProperties": false,
          "required": ["generation_id", "factor_checksum_sha256", "exposure_checksum_sha256", "source_lineage_sha256"],
          "properties": {
            "generation_id": {"$ref": "#/$defs/sha256"},
            "factor_checksum_sha256": {"$ref": "#/$defs/sha256"},
            "exposure_checksum_sha256": {"$ref": "#/$defs/sha256"},
            "source_lineage_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "label": {
          "type": "object", "additionalProperties": false,
          "required": ["generation_id", "manifest_digest_sha256", "data_checksum_sha256", "horizon_sessions", "formula_sha256"],
          "properties": {
            "generation_id": {"$ref": "#/$defs/sha256"},
            "manifest_digest_sha256": {"$ref": "#/$defs/sha256"},
            "data_checksum_sha256": {"$ref": "#/$defs/sha256"},
            "horizon_sessions": {"type": "integer", "minimum": 1},
            "formula_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "calendar": {
          "type": "object", "additionalProperties": false,
          "required": ["session_dates", "binding_sha256"],
          "properties": {
            "session_dates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/date"}},
            "binding_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "backtest_cost_config": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": [
                "generation_id", "manifest_digest_sha256", "start_date", "end_date",
                "commission_bps", "stamp_duty_bps", "slippage_bps", "minimum_commission_cny",
                "impact_type", "impact_coefficient_bps", "impact_maximum_bps",
                "impact_at_participation_cap_bps", "volume_participation_cap",
                "fill_rate_multiplier", "cost_proxy_bps_per_one_way_turnover"
              ],
              "properties": {
                "generation_id": {"$ref": "#/$defs/sha256"},
                "manifest_digest_sha256": {"$ref": "#/$defs/sha256"},
                "start_date": {"$ref": "#/$defs/date"},
                "end_date": {"$ref": "#/$defs/date"},
                "commission_bps": {"type": "number", "minimum": 0},
                "stamp_duty_bps": {"type": "number", "minimum": 0},
                "slippage_bps": {"type": "number", "minimum": 0},
                "minimum_commission_cny": {"type": "number", "minimum": 0},
                "impact_type": {"enum": ["linear", "square_root"]},
                "impact_coefficient_bps": {"type": "number", "minimum": 0},
                "impact_maximum_bps": {"type": "number", "minimum": 0},
                "impact_at_participation_cap_bps": {"type": "number", "minimum": 0},
                "volume_participation_cap": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                "fill_rate_multiplier": {"type": "number", "minimum": 0, "maximum": 1},
                "cost_proxy_bps_per_one_way_turnover": {"type": "number", "minimum": 0}
              }
            }
          ]
        }
      }
    },
    "environment_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["code_fingerprint", "environment_lock_digest_sha256"],
      "properties": {
        "code_fingerprint": {"$ref": "#/$defs/sha256"},
        "environment_lock_digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protocol": {"type": "object"},
    "feature_summary": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "pairwise_collinearity": {"type": "array", "items": {"type": "object"}},
    "daily": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "generation_id": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
