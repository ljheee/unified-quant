{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Suspension snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_version",
    "family",
    "generation_id",
    "manifest_digest_sha256",
    "window_start",
    "window_end",
    "primary_source",
    "reconciliation_source",
    "row_count",
    "data_checksum_sha256",
    "serialization_profile"
  ],
  "properties": {
    "snapshot_version": {"const": "1.0.0"},
    "family": {"const": "suspension_snapshot_v1"},
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "window_start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "window_end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "primary_source": {"type": "string", "minLength": 1},
    "reconciliation_source": {"type": "string", "minLength": 1},
    "row_count": {"type": "integer", "minimum": 0},
    "data_checksum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "serialization_profile": {"type": "string", "minLength": 1}
  }
}
