{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bars_daily_v2 market-data partition",
  "description": "One session of governed bars published under the MarketDatasetPublisher root. The parquet bytes are a byte-identical copy of the canonical bars_daily/v2 partition, so data_checksum_sha256 equals source_data_checksum_sha256 and the paper-execution market_data_binding resolves to the same artifact lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_version",
    "family",
    "generation_id",
    "manifest_digest_sha256",
    "partition_date",
    "window_start",
    "window_end",
    "source",
    "source_generation_id",
    "source_data_checksum_sha256",
    "row_count",
    "columns",
    "data_checksum_sha256",
    "serialization_profile"
  ],
  "properties": {
    "snapshot_version": {"const": "1.0.0"},
    "family": {"const": "bars_daily_v2"},
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "partition_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "window_start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "window_end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source": {"type": "string", "minLength": 1},
    "source_generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_data_checksum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row_count": {"type": "integer", "minimum": 0},
    "columns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "data_checksum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "serialization_profile": {"type": "string", "minLength": 1}
  }
}
