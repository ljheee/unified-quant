{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/target_weights.v1.json",
  "title": "Immutable target weights manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "schema_version",
    "decision_date",
    "portfolio_definition_generation_id",
    "prediction_set_generation_id",
    "universe_snapshot_generation_id",
    "instrument_count",
    "total_stock_weight",
    "cash_reserve",
    "weights_file",
    "weights_checksum_sha256",
    "columns",
    "dtypes",
    "row_count",
    "key_uniqueness",
    "logical_fingerprint",
    "serialization_profile_id",
    "run_id",
    "created_at",
    "quality_report_checksum_sha256",
    "manifest_digest_sha256",
    "generation_id"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "decision_date": {
      "$ref": "#/$defs/date"
    },
    "portfolio_definition_generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "prediction_set_generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "universe_snapshot_generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "instrument_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_stock_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cash_reserve": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "weights_file": {
      "type": "string",
      "minLength": 1
    },
    "weights_checksum_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    },
    "dtypes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "key_uniqueness": {
      "const": "instrument"
    },
    "logical_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "serialization_profile_id": {
      "const": "parquet-v1"
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "created_at": {
      "$ref": "#/$defs/date_time"
    },
    "quality_report_checksum_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "previous_target_weights_generation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "generation_id of prior target weights used as turnover cap baseline; null for first date"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    }
  }
}
