{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/risk_review_decision.v1.json",
  "title": "risk_review_decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation_id",
    "contract_version",
    "manifest_digest_sha256",
    "schema_version",
    "review_type",
    "subject_generation_id",
    "subject_manifest_digest_sha256",
    "subject_content_sha256",
    "review_status",
    "reviewer",
    "key_id",
    "policy",
    "errors",
    "warnings",
    "reviewed_at_utc",
    "review_signature_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "review_type": {
      "enum": [
        "risk_policy_activation",
        "risk_exception_grant",
        "risk_de_risk_contract_activation"
      ]
    },
    "subject_generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "subject_manifest_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "subject_content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "review_status": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "key_id": {
      "type": "string",
      "pattern": "^risk-reviewer-v1-[0-9]{4}-[0-9]{2}$"
    },
    "policy": {
      "const": "reject_all"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_at_utc": {
      "$ref": "#/$defs/date_time"
    },
    "review_signature_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_digest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "path_segment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "generation_id",
        "manifest_digest_sha256"
      ],
      "properties": {
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "generation_id": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_digest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_size",
        "serialization_profile"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "serialization_profile": {
          "enum": [
            "json-canonical-v1",
            "parquet-v1",
            "ndjson-v1"
          ]
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_code_fingerprint",
        "run_id",
        "created_at"
      ],
      "properties": {
        "producer_code_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "$ref": "#/$defs/uuid"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "created_at": {
          "$ref": "#/$defs/date_time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "approved"
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
