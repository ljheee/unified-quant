{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dividend_event_v1 corporate-action exclusion partition",
  "description": "Per-ex-date corporate-action exclusion set published under the MarketDatasetPublisher root. Rows are {date, instrument} pairs derived from the dividend disclosure store's implemented records, so the paper-execution corporate_action_binding can prove which instruments had a corporate action on which session.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_version",
    "family",
    "generation_id",
    "manifest_digest_sha256",
    "partition_date",
    "window_start",
    "window_end",
    "primary_source",
    "reconciliation_source",
    "source_generation_ids",
    "event_count",
    "row_count",
    "columns",
    "data_checksum_sha256",
    "serialization_profile"
  ],
  "properties": {
    "snapshot_version": {
      "const": "1.0.0"
    },
    "family": {
      "const": "dividend_event_v1"
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "partition_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window_start": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window_end": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "primary_source": {
      "type": "string",
      "minLength": 1
    },
    "reconciliation_source": {
      "type": "string",
      "minLength": 1
    },
    "source_generation_ids": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "description": "Dividend-event store generations that contributed rows. Empty is allowed only for an empty exclusion set (row_count == 0); the publisher rejects a non-empty set with no cited source."
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_checksum_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "serialization_profile": {
      "type": "string",
      "minLength": 1
    }
  }
}
