{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/label_set.v1.json",
  "title": "Model label set manifest v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version","name","semantic_version","primary_key","decision_time_convention","horizon_trading_days","formula_sha256","adjustment_basis","upstream_adjusted_price_bindings","eligibility","terminal_return_policy","null_policy","row_count","columns","dtypes","data_checksum_sha256","logical_fingerprint","code_fingerprint","serialization_profile_id","run_id","created_at","manifest_digest_sha256","generation_id"],
  "properties": {
    "contract_version": {"const": 1},
    "name": {"type":"string","minLength":1},
    "semantic_version": {"$ref":"#/$defs/semver"},
    "primary_key": {"type":"array","minItems":2,"uniqueItems":true,"items":{"enum":["instrument","decision_date"]}},
    "decision_time_convention": {"const":"trading_close_asia_shanghai"},
    "horizon_trading_days": {"type":"integer","minimum":1},
    "formula_sha256": {"$ref":"#/$defs/sha256"},
    "adjustment_basis": {"type":"string","minLength":1},
    "benchmark_binding": {"oneOf":[{"type":"null"},{"type":"object"}]},
    "upstream_adjusted_price_bindings": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/binding"}},
    "eligibility": {"type":"object","additionalProperties":false,"required":["rules"],"properties":{"rules":{"type":"object"}}},
    "terminal_return_policy": {"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["policy_id","final_price_source","availability_time"],"properties":{"policy_id":{"type":"string"},"final_price_source":{"type":"string"},"availability_time":{"$ref":"#/$defs/date_time"}}}]},
    "null_policy": {"type":"object","additionalProperties":false,"required":["insufficient_future"],"properties":{"insufficient_future":{"const":"null"}}},
    "row_count": {"type":"integer","minimum":0},
    "columns": {"type":"array","minItems":3,"uniqueItems":true,"items":{"type":"string"}},
    "dtypes": {"type":"object","minProperties":3,"additionalProperties":{"type":"string"}},
    "data_checksum_sha256": {"$ref":"#/$defs/sha256"}, "logical_fingerprint": {"$ref":"#/$defs/sha256"}, "code_fingerprint": {"$ref":"#/$defs/sha256"}, "serialization_profile_id": {"type":"string","minLength":1}, "run_id": {"$ref":"#/$defs/uuid"}, "created_at": {"$ref":"#/$defs/date_time"}, "manifest_digest_sha256": {"$ref":"#/$defs/sha256"}, "generation_id": {"$ref":"#/$defs/sha256"}
  },
  "allOf":[{"if":{"required":["columns"]},"then":{"properties":{"columns":{"contains":{"const":"instrument"}}}}},{"if":{"required":["columns"]},"then":{"properties":{"columns":{"contains":{"const":"decision_date"}}}}},{"if":{"required":["columns"]},"then":{"properties":{"columns":{"contains":{"const":"label"}}}}}],
  "$defs":{
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"}, "uuid": {"type":"string","format":"uuid"}, "semver": {"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"}, "date": {"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}, "date_time": {"type":"string","format":"date-time"},
    "binding": {"type":"object","additionalProperties":false,"required":["binding","dataset","schema_version","partition_date","generation_id","data_checksum_sha256","visible_cutoff"],"properties":{"binding":{"const":"adjusted_price"},"dataset":{"type":"string"},"schema_version":{"type":"string"},"partition_date":{"$ref":"#/$defs/date"},"generation_id":{"$ref":"#/$defs/sha256"},"data_checksum_sha256":{"$ref":"#/$defs/sha256"},"visible_cutoff":{"$ref":"#/$defs/date_time"}}}
  }
}
