{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/canonical_manifest.v2.json",
  "title": "Canonical partition manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version", "dataset", "schema_version", "partition_date",
    "row_count", "columns", "dtypes", "data_checksum_sha256",
    "schema_checksum_sha256", "code_fingerprint", "package_provenance",
    "run_id", "created_at", "lineage", "source_versions",
    "quality_report_checksum", "raw_artifacts", "generation_id",
    "manifest_digest_sha256", "trust_anchor_sha256"
  ],
  "properties": {
    "manifest_version": {"const": 2},
    "dataset": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "minLength": 1},
    "partition_date": {"type": "string", "format": "date"},
    "row_count": {"type": "integer", "minimum": 0},
    "columns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "minItems": 1},
    "dtypes": {"type": "object", "additionalProperties": {"type": "string"}},
    "data_checksum_sha256": {"$ref": "#/$defs/sha256"},
    "schema_checksum_sha256": {"$ref": "#/$defs/sha256"},
    "code_fingerprint": {"$ref": "#/$defs/sha256"},
    "package_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_version", "python_version", "pandas_version", "pyarrow_version", "numpy_version", "dependency_lock_sha256"],
      "properties": {
        "project_version": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "pandas_version": {"type": "string", "minLength": 1},
        "pyarrow_version": {"type": "string", "minLength": 1},
        "numpy_version": {"type": "string", "minLength": 1},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "run_id": {"$ref": "#/$defs/uuid"},
    "created_at": {"$ref": "#/$defs/date_time"},
    "lineage": {"type": "object"},
    "source_versions": {"type": "object"},
    "quality_report_checksum": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"const": ""}]},
    "raw_artifacts": {"type": "object"},
    "generation_id": {"$ref": "#/$defs/sha256"},
    "manifest_digest_sha256": {"$ref": "#/$defs/sha256"},
    "trust_anchor_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "format": "uuid"},
    "date_time": {"type": "string", "format": "date-time"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "real_date": {"type": "string", "format": "date"}
  }
}
