{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/feature_preprocessing.v2.json",
  "title": "Governed PIT factor neutralization preprocessing manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "preprocess_name", "semantic_version", "input_factor_set",
    "input_factor_version", "input_factor_generation_ids", "input_frame_sha256",
    "output_feature_schema_manifest_digest_sha256", "output_feature_schema_generation_id",
    "input_feature_schema_manifest_digest_sha256", "input_feature_schema_generation_id",
    "ordered_features", "key_columns", "transform", "policy", "group_columns",
    "factor_exposure_binding", "output_frame_row_count", "output_frame_sha256",
    "code_fingerprint", "serialization_profile_id", "run_id", "created_at",
    "quality_report_checksum_sha256", "manifest_digest_sha256", "generation_id"
  ],
  "properties": {
    "contract_version": {"const": 2},
    "preprocess_name": {"$ref": "#/$defs/path_segment"},
    "semantic_version": {"$ref": "#/$defs/semver"},
    "input_factor_set": {"type": "string", "minLength": 1},
    "input_factor_version": {"$ref": "#/$defs/semver"},
    "input_factor_generation_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "input_frame_sha256": {"$ref": "#/$defs/sha256"},
    "ordered_features": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "key_columns": {"const": ["instrument", "datetime"]},
    "transform": {"const": "neutralize_factor_panel"},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "null_result", "control_order", "design", "visibility_policy"],
      "properties": {
        "type": {"const": "pit_factor_neutralization_v1"},
        "null_result": {"const": "preserve_null"},
        "control_order": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["industry", "market_cap", "liquidity"]}
        },
        "design": {"const": "per_session_ols_residual_v1"},
        "visibility_policy": {"const": "session_close_asia_shanghai_v1"}
      }
    },
    "group_columns": {"const": ["datetime"]},
    "factor_exposure_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["generation_id", "manifest_digest_sha256", "data_checksum_sha256"],
      "properties": {
        "generation_id": {"$ref": "#/$defs/sha256"},
        "manifest_digest_sha256": {"$ref": "#/$defs/sha256"},
        "data_checksum_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "output_frame_row_count": {"type": "integer", "minimum": 1},
    "output_frame_sha256": {"$ref": "#/$defs/sha256"},
    "code_fingerprint": {"$ref": "#/$defs/sha256"},
    "serialization_profile_id": {"type": "string", "minLength": 1},
    "run_id": {"$ref": "#/$defs/uuid"},
    "created_at": {"$ref": "#/$defs/date_time"},
    "quality_report_checksum_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_digest_sha256": {"$ref": "#/$defs/sha256"},
    "generation_id": {"$ref": "#/$defs/sha256"},
    "input_feature_schema_generation_id": {"$ref": "#/$defs/sha256"},
    "input_feature_schema_manifest_digest_sha256": {"$ref": "#/$defs/sha256"},
    "output_feature_schema_generation_id": {"$ref": "#/$defs/sha256"},
    "output_feature_schema_manifest_digest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "path_segment": {
      "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {"enum": [".", ".."]}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "format": "uuid"},
    "semver": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "date_time": {"type": "string", "format": "date-time"}
  }
}
