{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/backtest_stress.v1.json",
  "title": "Recomputable assumed-liquidity cost and capital stress diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "diagnostic_only",
    "calibration_status",
    "data_root",
    "baseline_binding",
    "capital_grid",
    "capacity_policy",
    "scenarios",
    "conclusions",
    "execution_environment",
    "generation_id",
    "manifest_digest_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "diagnostic_only": {
      "const": true
    },
    "calibration_status": {
      "const": "assumptions_not_market_calibrated"
    },
    "data_root": {
      "type": "string",
      "minLength": 1
    },
    "baseline_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "manifest_digest_sha256"
      ],
      "properties": {
        "generation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "capital_grid": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "capacity_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_fill_ratio",
        "maximum_risk_breach_sessions",
        "require_positive_return"
      ],
      "properties": {
        "minimum_fill_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_risk_breach_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "require_positive_return": {
          "type": "boolean"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "config_binding",
          "result_binding",
          "initial_capital",
          "metrics",
          "meets_capacity_policy"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(commission_x2|slippage_x2|fill_rate_half|capital_[0-9]+)$"
          },
          "config_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "generation_id",
              "manifest_digest_sha256"
            ],
            "properties": {
              "generation_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "manifest_digest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "result_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "generation_id",
              "manifest_digest_sha256"
            ],
            "properties": {
              "generation_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "manifest_digest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "initial_capital": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cumulative_return",
              "max_drawdown",
              "fill_ratio",
              "unpriced_order_count",
              "requested_notional_cny",
              "filled_notional_cny",
              "total_commission_cny",
              "total_stamp_duty_cny",
              "total_slippage_cny",
              "total_impact_cny",
              "avg_daily_turnover",
              "risk_budget_breach_sessions"
            ],
            "properties": {
              "cumulative_return": {
                "type": "number",
                "exclusiveMinimum": -1
              },
              "max_drawdown": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "fill_ratio": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "unpriced_order_count": {
                "type": "integer",
                "minimum": 0
              },
              "requested_notional_cny": {
                "type": "number",
                "minimum": 0
              },
              "filled_notional_cny": {
                "type": "number",
                "minimum": 0
              },
              "total_commission_cny": {
                "type": "number",
                "minimum": 0
              },
              "total_stamp_duty_cny": {
                "type": "number",
                "minimum": 0
              },
              "total_slippage_cny": {
                "type": "number",
                "minimum": 0
              },
              "total_impact_cny": {
                "type": "number",
                "minimum": 0
              },
              "avg_daily_turnover": {
                "type": "number",
                "minimum": 0
              },
              "risk_budget_breach_sessions": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "meets_capacity_policy": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "conclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_metrics",
        "positive_base_and_stress_returns",
        "maximum_tested_capital_meeting_policy",
        "tested_grid_only",
        "market_capacity_certified"
      ],
      "properties": {
        "baseline_metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cumulative_return",
            "max_drawdown",
            "fill_ratio",
            "unpriced_order_count",
            "requested_notional_cny",
            "filled_notional_cny",
            "total_commission_cny",
            "total_stamp_duty_cny",
            "total_slippage_cny",
            "total_impact_cny",
            "avg_daily_turnover",
            "risk_budget_breach_sessions"
          ],
          "properties": {
            "cumulative_return": {
              "type": "number",
              "exclusiveMinimum": -1
            },
            "max_drawdown": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "fill_ratio": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "unpriced_order_count": {
              "type": "integer",
              "minimum": 0
            },
            "requested_notional_cny": {
              "type": "number",
              "minimum": 0
            },
            "filled_notional_cny": {
              "type": "number",
              "minimum": 0
            },
            "total_commission_cny": {
              "type": "number",
              "minimum": 0
            },
            "total_stamp_duty_cny": {
              "type": "number",
              "minimum": 0
            },
            "total_slippage_cny": {
              "type": "number",
              "minimum": 0
            },
            "total_impact_cny": {
              "type": "number",
              "minimum": 0
            },
            "avg_daily_turnover": {
              "type": "number",
              "minimum": 0
            },
            "risk_budget_breach_sessions": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "positive_base_and_stress_returns": {
          "type": "boolean"
        },
        "maximum_tested_capital_meeting_policy": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "tested_grid_only": {
          "const": true
        },
        "market_capacity_certified": {
          "const": false
        }
      }
    },
    "execution_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_fingerprint",
        "environment_lock_digest_sha256",
        "git_head"
      ],
      "properties": {
        "code_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_lock_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "git_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "generation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
