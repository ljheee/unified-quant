{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research run request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "schema_version",
    "research_name",
    "execution_mode",
    "run_visible_cutoff",
    "decision_timezone",
    "window_start_date",
    "window_end_date",
    "factor_binding",
    "universe_snapshot_binding",
    "adjusted_price_binding",
    "label_binding",
    "feature_preprocessing_binding",
    "model_definition_template",
    "dataset_policy_template",
    "portfolio_definition_template",
    "backtest_config_binding",
    "environment",
    "stage_plan_sha256",
    "run_id",
    "created_at",
    "request_content_generation_id",
    "manifest_digest_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "research_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "execution_mode": {
      "const": "full_research_run"
    },
    "run_visible_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "decision_timezone": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_+/.-]{1,64}$"
    },
    "window_start_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "window_end_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "factor_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "generation_id",
        "manifest_digest_sha256"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "generation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "universe_snapshot_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "generation_id",
        "manifest_digest_sha256"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "generation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "adjusted_price_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "data_checksum_sha256"
      ],
      "properties": {
        "generation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "data_checksum_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "label_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "generation_id",
        "manifest_digest_sha256"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "generation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "feature_preprocessing_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "generation_id",
        "manifest_digest_sha256"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "generation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "model_definition_template": {
      "$ref": "model_definition_template.v1.json"
    },
    "portfolio_definition_template": {
      "$ref": "portfolio_definition_template.v1.json"
    },
    "backtest_config_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "generation_id",
        "manifest_digest_sha256"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "generation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_fingerprint",
        "environment_lock_digest_sha256",
        "serialization_profile_id",
        "thread_count",
        "seed"
      ],
      "properties": {
        "code_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_lock_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "serialization_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "thread_count": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stage_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_content_generation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_policy_template": {
      "$ref": "dataset_policy_template.v1.json"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "path_segment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
