{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/sample_construction.v1.json",
  "title": "Governed training-sample construction manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "sample_name",
    "semantic_version",
    "window_start",
    "window_end",
    "source_factor_set",
    "source_factor_version",
    "source_factor_generation_ids",
    "source_factor_partition_set_digest_sha256",
    "source_label_set_name",
    "source_label_generation_id",
    "source_label_manifest_digest_sha256",
    "source_label_data_checksum_sha256",
    "source_universe_snapshot_generation_id",
    "source_index_membership_set_digest_sha256",
    "ordered_features",
    "selection_policy",
    "rows_before_selection",
    "rows_after_selection",
    "dropped_rows",
    "dropped_labels",
    "columns",
    "dtypes",
    "row_count",
    "data_checksum_sha256",
    "logical_fingerprint",
    "code_fingerprint",
    "serialization_profile_id",
    "quality_report_checksum_sha256",
    "run_id",
    "created_at",
    "generation_id",
    "manifest_digest_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "sample_name": {
      "$ref": "#/$defs/path_segment"
    },
    "semantic_version": {
      "$ref": "#/$defs/semver"
    },
    "window_start": {
      "$ref": "#/$defs/date"
    },
    "window_end": {
      "$ref": "#/$defs/date"
    },
    "source_factor_set": {
      "type": "string",
      "minLength": 1
    },
    "source_factor_version": {
      "$ref": "#/$defs/semver"
    },
    "source_factor_generation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "source_factor_partition_set_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_label_set_name": {
      "type": "string",
      "minLength": 1
    },
    "source_label_generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "source_label_manifest_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_label_data_checksum_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_universe_snapshot_generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "source_index_membership_set_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "ordered_features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "feature_null",
        "label_null",
        "absent_label_key"
      ],
      "properties": {
        "type": {
          "const": "pit_label_join_v1"
        },
        "feature_null": {
          "enum": [
            "drop",
            "refuse"
          ]
        },
        "label_null": {
          "enum": [
            "drop",
            "refuse"
          ]
        },
        "absent_label_key": {
          "enum": [
            "drop",
            "refuse"
          ]
        }
      }
    },
    "rows_before_selection": {
      "type": "integer",
      "minimum": 0
    },
    "rows_after_selection": {
      "type": "integer",
      "minimum": 1
    },
    "dropped_rows": {
      "type": "object"
    },
    "dropped_labels": {
      "type": "object"
    },
    "columns": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "dtypes": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "string"
      }
    },
    "row_count": {
      "type": "integer",
      "minimum": 1
    },
    "data_checksum_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "logical_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "code_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "serialization_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "quality_report_checksum_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "created_at": {
      "$ref": "#/$defs/date_time"
    },
    "generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_digest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "path_segment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    }
  }
}
