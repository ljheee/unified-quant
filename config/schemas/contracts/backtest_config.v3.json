{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/backtest_config.v3.json",
  "title": "Raw chronological trading backtest config v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "schema_version",
    "backtest_name",
    "start_date",
    "end_date",
    "execution_model",
    "cost_model",
    "limit_rules",
    "calendar_binding",
    "price_source_binding",
    "universe_binding",
    "initial_capital",
    "run_id",
    "created_at",
    "quality_report_checksum_sha256",
    "manifest_digest_sha256",
    "generation_id",
    "corporate_action_binding",
    "suspension_binding",
    "execution_facts_binding",
    "risk_constraints"
  ],
  "properties": {
    "contract_version": {
      "const": 3
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "backtest_name": {
      "$ref": "#/$defs/path_segment"
    },
    "start_date": {
      "$ref": "#/$defs/date"
    },
    "end_date": {
      "$ref": "#/$defs/date"
    },
    "execution_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sellable_quantity_rule",
        "lot_rule_source",
        "volume_participation_cap",
        "fill_rate_multiplier",
        "rebalance_every_n_sessions"
      ],
      "properties": {
        "type": {
          "const": "daily_t1_open"
        },
        "sellable_quantity_rule": {
          "const": "prior_day_holding_only"
        },
        "lot_rule_source": {
          "const": "execution_facts"
        },
        "volume_participation_cap": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "fill_rate_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rebalance_every_n_sessions": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cost_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commission_bps",
        "stamp_duty_bps",
        "slippage_bps",
        "minimum_commission_cny",
        "commission_basis",
        "fee_rounding",
        "impact_model"
      ],
      "properties": {
        "commission_bps": {
          "type": "number",
          "minimum": 0
        },
        "stamp_duty_bps": {
          "type": "number",
          "minimum": 0
        },
        "slippage_bps": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 10000
        },
        "minimum_commission_cny": {
          "type": "number",
          "minimum": 0
        },
        "commission_basis": {
          "const": "executed_notional"
        },
        "fee_rounding": {
          "const": "half_up_cent"
        },
        "impact_model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coefficient_bps",
            "maximum_bps"
          ],
          "properties": {
            "type": {
              "enum": [
                "linear",
                "square_root"
              ]
            },
            "coefficient_bps": {
              "type": "number",
              "minimum": 0
            },
            "maximum_bps": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 10000
            }
          }
        }
      }
    },
    "limit_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "price_basis"
      ],
      "properties": {
        "type": {
          "const": "published_daily_price_bands"
        },
        "price_basis": {
          "const": "raw_unadjusted_cny"
        }
      }
    },
    "calendar_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "checksum_sha256"
      ],
      "properties": {
        "generation_id": {
          "$ref": "#/$defs/sha256"
        },
        "checksum_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "price_source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "window_start",
        "window_end",
        "set_digest_sha256",
        "member_count"
      ],
      "properties": {
        "family": {
          "const": "bars_daily_v2"
        },
        "window_start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "window_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "set_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "member_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "universe_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_generation_id"
      ],
      "properties": {
        "snapshot_generation_id": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "initial_capital": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "created_at": {
      "$ref": "#/$defs/date_time"
    },
    "quality_report_checksum_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "corporate_action_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_generation_id",
        "data_checksum_sha256"
      ],
      "properties": {
        "dataset_generation_id": {
          "$ref": "#/$defs/sha256"
        },
        "data_checksum_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "suspension_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_generation_id",
        "data_checksum_sha256"
      ],
      "properties": {
        "dataset_generation_id": {
          "$ref": "#/$defs/sha256"
        },
        "data_checksum_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "execution_facts_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "manifest_digest_sha256",
        "data_checksum_sha256",
        "logical_checksum_sha256"
      ],
      "properties": {
        "generation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "data_checksum_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "logical_checksum_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "risk_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_single_weight",
        "max_industry_weight",
        "max_turnover",
        "cash_reserve"
      ],
      "properties": {
        "max_single_weight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_industry_weight": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_turnover": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cash_reserve": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_drawdown_stop": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "maximum": 0.95
        },
        "volatility_target": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "target_annualized",
            "lookback_sessions",
            "min_history_sessions"
          ],
          "properties": {
            "target_annualized": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5
            },
            "lookback_sessions": {
              "type": "integer",
              "minimum": 2,
              "maximum": 756
            },
            "min_history_sessions": {
              "type": "integer",
              "minimum": 2,
              "maximum": 756
            }
          }
        }
      }
    }
  },
  "$defs": {
    "path_segment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    }
  }
}
