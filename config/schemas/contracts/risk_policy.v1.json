{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/risk_policy.v1.json",
  "title": "risk_policy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "schema_version",
    "policy_id",
    "policy_version",
    "policy_scope",
    "activation_status",
    "effective_from",
    "effective_to",
    "rules",
    "industry_membership_binding",
    "approval_binding",
    "producer",
    "serialization_profile",
    "generation_id",
    "manifest_digest_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "$ref": "#/$defs/path_segment"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "policy_scope": {
      "enum": [
        "strategy",
        "portfolio",
        "account"
      ]
    },
    "activation_status": {
      "enum": [
        "draft",
        "approved",
        "retired"
      ]
    },
    "effective_from": {
      "$ref": "#/$defs/date"
    },
    "effective_to": {
      "anyOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "rule_scope",
          "metric",
          "operator",
          "threshold",
          "action",
          "severity",
          "priority",
          "state_required"
        ],
        "properties": {
          "rule_id": {
            "$ref": "#/$defs/path_segment"
          },
          "rule_scope": {
            "enum": [
              "strategy",
              "portfolio",
              "account",
              "order"
            ]
          },
          "metric": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$"
          },
          "operator": {
            "enum": [
              "greater_than",
              "greater_than_or_equal",
              "less_than",
              "less_than_or_equal"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "action": {
            "enum": [
              "allow",
              "warn",
              "resize",
              "block",
              "block_order",
              "block_new_buy",
              "de_risk",
              "flatten",
              "halt_strategy",
              "escalate_review"
            ]
          },
          "severity": {
            "enum": [
              "warning",
              "error",
              "critical"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "state_required": {
            "type": "boolean"
          },
          "state_window_days": {
            "type": "integer",
            "minimum": 0
          },
          "hysteresis_exit_threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "cooldown_days": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "industry_membership_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/binding"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "review_generation_id",
        "review_manifest_digest_sha256"
      ],
      "properties": {
        "review_generation_id": {
          "$ref": "#/$defs/sha256"
        },
        "review_manifest_digest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "family": {
          "enum": [
            "risk_review_decision_v1"
          ]
        }
      }
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "serialization_profile": {
      "const": "json-canonical-v1"
    },
    "generation_id": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_digest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "path_segment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "generation_id",
        "manifest_digest_sha256"
      ],
      "properties": {
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "generation_id": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_digest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_size",
        "serialization_profile"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "serialization_profile": {
          "enum": [
            "json-canonical-v1",
            "parquet-v1",
            "ndjson-v1"
          ]
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_code_fingerprint",
        "run_id",
        "created_at"
      ],
      "properties": {
        "producer_code_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "$ref": "#/$defs/uuid"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "created_at": {
          "$ref": "#/$defs/date_time"
        }
      }
    }
  }
}
