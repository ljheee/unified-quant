{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/adjustment_golden_provenance.v2.json",
  "title": "Corporate-action golden provenance v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provenance_version",
    "certification",
    "cases"
  ],
  "properties": {
    "provenance_version": {
      "const": 2
    },
    "certification": {
      "type": "string",
      "enum": [
        "pending-authoritative-source",
        "certified-authoritative-source"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "publisher",
        "locator",
        "publication_date",
        "quoted_locator",
        "file_sha256",
        "retrieved_at_utc",
        "license_or_terms"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exchange-reference",
            "settlement-reference",
            "issuer-announcement",
            "market-data-provider",
            "derived-formula"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "format": "uri",
          "minLength": 8
        },
        "publication_date": {
          "$ref": "#/$defs/date"
        },
        "quoted_locator": {
          "type": "string",
          "minLength": 3
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "retrieved_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "license_or_terms": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "event_type",
        "instrument",
        "record_date",
        "ex_date",
        "inputs",
        "expected_ex_right_price",
        "tolerance_abs",
        "event_evidence",
        "pre_close_evidence",
        "reference_price_evidence"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "enum": [
            "cash",
            "bonus_transfer",
            "rights",
            "cash_bonus_transfer",
            "combined"
          ]
        },
        "instrument": {
          "type": "string",
          "pattern": "^[0-9]{6}\\.(XSHG|XSHE)$"
        },
        "record_date": {
          "$ref": "#/$defs/date"
        },
        "ex_date": {
          "$ref": "#/$defs/date"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pre_close",
            "cash_per_ten",
            "bonus_per_ten",
            "rights_per_ten",
            "rights_price"
          ],
          "properties": {
            "pre_close": {
              "type": "number",
              "minimum": 0
            },
            "cash_per_ten": {
              "type": "number",
              "minimum": 0
            },
            "bonus_per_ten": {
              "type": "number",
              "minimum": 0
            },
            "rights_per_ten": {
              "type": "number",
              "minimum": 0
            },
            "rights_price": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "expected_ex_right_price": {
          "type": "number"
        },
        "tolerance_abs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "event_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "pre_close_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "reference_price_evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "certification": {
            "const": "certified-authoritative-source"
          }
        }
      },
      "then": {
        "properties": {
          "cases": {
            "items": {
              "properties": {
                "pre_close_evidence": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "exchange-reference",
                        "settlement-reference"
                      ]
                    }
                  }
                },
                "reference_price_evidence": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "exchange-reference",
                        "settlement-reference"
                      ]
                    }
                  }
                }
              },
              "required": [
                "pre_close_evidence",
                "reference_price_evidence"
              ]
            }
          }
        }
      }
    }
  ]
}
