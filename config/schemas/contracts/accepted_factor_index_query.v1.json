{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/accepted_factor_index_query.v1.json",
  "title": "Typed accepted-factor index/list query contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "filters", "ordering", "visibility"],
  "properties": {
    "contract_version": {"const": 1},
    "filters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "factor_set": {"type": "string", "minLength": 1},
        "factor_version": {"$ref": "#/$defs/semver"},
        "generation_id": {"$ref": "#/$defs/sha256"},
        "date_from": {"$ref": "#/$defs/date"},
        "date_to": {"$ref": "#/$defs/date"}
      }
    },
    "ordering": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["factor_set", "factor_version", "partition_date", "generation_id"]}},
    "pagination": {
      "type": "object", "additionalProperties": false, "required": ["limit"],
      "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 10000}, "after_sort_key": {"type": ["array", "null"], "items": {"type": "string"}}}
    },
    "visibility": {"const": "accepted_only"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
