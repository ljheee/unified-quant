{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-quant.local/schemas/contracts/risk_review_trust_anchor.v1.json",
  "title": "risk_review_trust_anchor.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "registry_version",
    "status",
    "anchors"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "registry_version": {
      "const": 1
    },
    "status": {
      "const": "reviewed"
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trust_anchor_version",
          "algorithm",
          "key_id",
          "public_key_hex",
          "reviewer",
          "valid_from",
          "valid_to",
          "review_types"
        ],
        "properties": {
          "trust_anchor_version": {
            "const": 1
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "key_id": {
            "type": "string",
            "pattern": "^risk-reviewer-v1-[0-9]{4}-[0-9]{2}$"
          },
          "public_key_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "valid_from": {
            "$ref": "#/$defs/date"
          },
          "valid_to": {
            "anyOf": [
              {
                "$ref": "#/$defs/date"
              },
              {
                "type": "null"
              }
            ]
          },
          "review_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "risk_policy_activation",
                "risk_exception_grant",
                "risk_de_risk_contract_activation"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "path_segment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "generation_id",
        "manifest_digest_sha256"
      ],
      "properties": {
        "family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "generation_id": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_digest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_size",
        "serialization_profile"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$",
          "not": {
            "pattern": "(^|/)\\.\\.?(/|$)"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "serialization_profile": {
          "enum": [
            "json-canonical-v1",
            "parquet-v1",
            "ndjson-v1"
          ]
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_code_fingerprint",
        "run_id",
        "created_at"
      ],
      "properties": {
        "producer_code_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "run_id": {
          "$ref": "#/$defs/uuid"
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "created_at": {
          "$ref": "#/$defs/date_time"
        }
      }
    }
  }
}
