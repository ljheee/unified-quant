{
  "canonical_manifest.v2.json": [
    {"case": "invalid_date", "patch": {"partition_date": "2026-02-30"}},
    {"case": "invalid_uuid", "patch": {"run_id": "not-a-uuid"}},
    {"case": "bad_checksum", "patch": {"data_checksum_sha256": "xyz"}},
    {"case": "missing_field", "remove": ["generation_id"]}
  ],
  "canonical_migration.v1.json": [
    {"case": "bad_action", "patch": {"action": "overwrite_v1"}},
    {"case": "bad_schema", "patch": {"source_schema_version": "v3"}},
    {"case": "missing_approval", "remove": ["approval_reference"]},
    {"case": "bad_checksum", "patch": {"mapping_checksum_sha256": "short"}}
  ],
  "adjustment_snapshot.v1.json": [
    {"case": "bad_symbol", "patch": {"instrument": "AAPL"}},
    {"case": "bad_formula", "patch": {"formula_version": "adj_factor.derived_v4"}},
    {"case": "bad_visibility_type", "patch": {"visibility_time": 123}},
    {"case": "missing_generation", "remove": ["generation_id"]}
  ],
  "factor_manifest.v1.json": [
    {"case": "extra_field", "patch": {"unexpected": true}},
    {"case": "bad_semver", "patch": {"factor_version": "1.0"}},
    {"case": "empty_inputs", "replace": {"inputs": []}},
    {"case": "bad_quality_status", "patch": {"quality": {"status": "maybe", "policy": "reject_all", "report_checksum_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}}
  ],
  "universe_snapshot.v1.json": [
    {"case": "bad_checksum", "patch": {"members_artifact": {"path": "x.csv", "checksum_sha256": "nope"}}},
    {"case": "missing_valid_from", "remove": ["valid_from"]}
  ],
  "quality_report.v1.json": [
    {"case": "bad_binding", "patch": {"binding_type": "unknown"}},
    {"case": "no_checks", "replace": {"checks": []}}
  ]
}
